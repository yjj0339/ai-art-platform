# 服务端环境变量模板
# 用法：复制本文件为 server/.env，按下面说明逐项填写。
# ⚠️ server/.env 内含真实密钥，已被 .gitignore 排除，禁止提交到仓库或发给他人。

PORT=3000

# 生产环境必须使用 server：所有 /api 业务接口均要求登录会话。
# demo 仅用于现有前端演示，不得用于服务器部署。
AUTH_MODE=server

# PostgreSQL 连接串，格式：postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# 前端访问来源，必须与实际域名/端口完全一致，否则接口会被来源校验拦截。
# 本地开发示例：http://127.0.0.1:5173
APP_ORIGIN=
SESSION_COOKIE_NAME=sid
SESSION_TTL_DAYS=7
# 正式 HTTPS 环境必须为 true；本地 HTTP 调试临时改 false。
SESSION_COOKIE_SECURE=false

# 首次创建机构、校区和管理员前填写。执行 pnpm db:bootstrap-admin 后删除或清空管理员密码。
DEFAULT_ORGANIZATION_CODE=
DEFAULT_ORGANIZATION_NAME=
LOGIN_DEFAULT_ORGANIZATION_CODE=
DEFAULT_CAMPUS_CODE=
DEFAULT_CAMPUS_NAME=
BOOTSTRAP_ADMIN_ACCOUNT=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# 业务数据与生成图片的持久化目录（必须是绝对路径或稳定的相对路径，不能依赖系统临时目录）
AI_DATA_DIR=./server/data

# 默认出图供应商：agnes / volcengine / openai
AI_DEFAULT_PROVIDER=

# —— Agnes 供应商 ——
AGNES_API_KEY=
AGNES_BASE_URL=
AGNES_IMAGE_MODEL=
AGNES_VIDEO_MODEL=

# —— 火山引擎（方舟 / Seedream）——
VOLCENGINE_API_KEY=
VOLCENGINE_BASE_URL=
VOLCENGINE_IMAGE_MODEL=

# —— OpenAI 兼容接口 ——
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=

# 腾讯混元生3D。密钥只允许放在服务端 server/.env，勿提交到仓库。
# 子账号需具备 QcloudAI3DFullAccess 权限。
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_AI3D_REGION=
TENCENT_AI3D_MODEL=

# 作品广场自动审核：平台每日审核费用总上限（元）。为空或 0 时后台无法启用 AI 审核
GALLERY_DAILY_BUDGET_CNY=

# —— 安全与反向代理（正式部署必看）——
# 服务只监听 127.0.0.1，正式环境由本机 Nginx 转发进来。前面是自己的 Nginx 时必须设为 true，
# 否则所有访客都会被当成同一个 IP：登录保护可能把所有人一起锁住，访客限流也会互相影响。
# 没有反向代理、直接访问时保持 false（不然任何人都能伪造 IP）。
TRUST_PROXY=false
# 风控用的哈希密钥（登录失败计数、访客限流的键）。填一串随机字符，设置后不要再改。
# 不填时依次借用 AI_CREDENTIAL_ENCRYPTION_KEY、DATABASE_URL；它们一变，登录失败计数会清零（无害）。
RISK_HASH_SECRET=
# 加密保存在 AI_DATA_DIR 里的腾讯混元 3D 凭据。填一串随机字符，设置后不要再改，否则后台要重新填写 3D 凭据。
# 不填时会在 AI_DATA_DIR 里自动生成 .tencent-ai3d-credentials.key，迁移服务器时要连同数据目录一起带走。
AI_CREDENTIAL_ENCRYPTION_KEY=
# 数据看板按天统计、风控夜间时段按这个时区计算
APP_TIMEZONE=Asia/Shanghai

# —— 登录保护 ——
# 同一账号连续输错几次后锁定（最少 3）。锁定时长 1、2、4、8… 分钟逐次翻倍，最长 LOGIN_LOCK_MINUTES。
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 同一网络（出口 IP）登录同一机构，净失败达到这个次数后整个网络暂停登录 LOGIN_LOCK_MINUTES 分钟（最少 10）。
# 管理员可以在后台「账号安全 → 登录锁定」里提前解除。
LOGIN_IP_MAX_FAILURES=50
# 同一网络里每个账号登录成功一次（同一账号每 15 分钟最多一次）抵扣几次失败，全班共用一个网络时不容易误锁；0 表示不抵扣。
LOGIN_IP_SUCCESS_CREDIT=3

# —— 文字模型（AI 伙伴、技能、报告等）——
# 默认文字供应商：volcengine / deepseek / openai / agnes。后台「API 配置」里设过默认文字模型时以后台为准；都没设时跟默认出图供应商走
AI_DEFAULT_TEXT_PROVIDER=
VOLCENGINE_TEXT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_TEXT_MODEL=
OPENAI_TEXT_MODEL=
AGNES_TEXT_MODEL=
# 访问境外供应商需要代理时填写，例如 http://127.0.0.1:7890；国内供应商不用填
HTTPS_PROXY=

# —— 平台级技能管理（可选）——
# 填平台运营机构的 ID 后，这个机构的管理员可以管理「平台公共技能」；PLATFORM_SKILL_ADMIN_IDS 填用户 ID（逗号分隔）可进一步限定到指定管理员。
PLATFORM_ORGANIZATION_ID=
PLATFORM_SKILL_ADMIN_IDS=

# —— 其他可选项（不填就用括号里的默认值）——
# 作品广场自动审核后台任务，false 表示关闭（默认开启）
GALLERY_WORKER_ENABLED=
# AI 伙伴回复时，模型超过多久（毫秒）没有新内容就放弃本次回复，避免一直卡住（默认 60000）
AGENT_IDLE_TIMEOUT_MS=
# 上传大小上限（字节）：普通素材（25MB）、课程文件（32MB）、课程视频（512MB）
MAX_ASSET_BYTES=
MAX_COURSE_ASSET_BYTES=
MAX_COURSE_VIDEO_BYTES=
# 课件转换工具路径：PPT 转 PDF 用 LibreOffice（soffice），PDF 转图片用 pdftoppm；已在 PATH 里就不用填
PPT_CONVERTER_BIN=
PDF_RENDER_BIN=
