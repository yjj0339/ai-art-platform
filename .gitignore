scripts/.probe-*
scripts/.restore-*.mjs
scripts/.check-*.mjs
.tmp-crop/
.tmp-pw/

# 验收截图产物（体积大，不入库）
.workbuddy/evidence/
# 截图脚本生成的对照页面（scripts/shot-portfolio-batch.mjs 等每次重跑覆盖）
.workbuddy/preview/
# 手动排查时开的无头浏览器配置目录（--dump-dom 用，几十 MB，删不掉也不影响运行）
.workbuddy/.probe-edge*/

# 素材库批量操作下拉菜单层级验证产物（scripts/verify-portfolio-batch-menu-layer.mjs）
