# mock: 永远使用前端Mock结果
# auto: 优先请求后端AI接口，失败后自动回退Mock
# api: 只请求真实后端AI接口，失败直接报错
VITE_AI_MODE=mock
VITE_AUTH_MODE=mock

# 真实后端网关地址。前端会请求：
# GET  {VITE_API_BASE_URL}/ai/health
# POST {VITE_API_BASE_URL}/ai/image/generate
VITE_API_BASE_URL=/api

# 后端真实密钥不要放在前端 .env.local。
# 请复制 server/.env.example 为 server/.env，并把 OPENAI_API_KEY 填在那里。

# 服务器部署时改为 server，前端将使用 HttpOnly 会话 Cookie，不在浏览器存储 Token。
# VITE_AUTH_MODE=server
# VITE_ORGANIZATION_CODE=demo-school
